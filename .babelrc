{
  "presets": [
    [
      "@babel/preset-env",
      {
        "useBuiltIns": false
      }
    ]
  ],
  "plugins": [
    "@babel/plugin-transform-runtime",
    [
      "@babel/plugin-transform-async-to-generator",
      {
        "module": "bluebird",
        "method": "coroutine"
      }
    ],
    "dynamic-import-node",
    "transform-imports",
    [
      "module-resolver",
      {
        "alias": {
          "@": "./src",
          "@test": "./__test__"
        }
      }
    ]
  ]
}
